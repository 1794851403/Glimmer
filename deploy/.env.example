# 复制为 .env 后修改；.env 不入库
# VM 的固定 IP；不要把端口绑到 0.0.0.0 暴露到不可信网络
BIND_IP=192.168.157.129

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=glimmer
MYSQL_USER=glimmer
MYSQL_PASSWORD=change-me-mysql

# Redis：两个实例使用不同密码
REDIS_CORE_PASSWORD=change-me-core
REDIS_CACHE_PASSWORD=change-me-cache
REDIS_CORE_MAXMEMORY=512mb
REDIS_CACHE_MAXMEMORY=1536mb

# RabbitMQ
RABBITMQ_DEFAULT_USER=glimmer
RABBITMQ_DEFAULT_PASS=change-me-rabbit
RABBITMQ_VERSION=3.13.7
DELAYED_PLUGIN_VERSION=3.13.0

# Elasticsearch / Kibana
ES_VERSION=8.15.0
IK_VERSION=8.15.0
# 值中含空格必须加引号：smoke.sh 会 source 本文件
ES_JAVA_OPTS="-Xms512m -Xmx512m"

# 后端（backend 启动时通过 spring.config.import 读取本文件）
# 至少 32 字节；生成示例：openssl rand -base64 48
JWT_SECRET=change-me-generate-at-least-32-bytes

# 图片存储：local 写本地 ./uploads；oss 走后端中转上传
STORAGE_TYPE=local
STORAGE_LOCAL_BASE_URL=http://localhost:8080
# STORAGE_LOCAL_ROOT=./uploads

# OSS（STORAGE_TYPE=oss 时必填；不要提交真实密钥）
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=change-me
OSS_ACCESS_KEY_ID=change-me
OSS_ACCESS_KEY_SECRET=change-me
# 可选 CDN / 自定义域名；为空时使用 https://{bucket}.{endpoint}
# OSS_PUBLIC_BASE_URL=
